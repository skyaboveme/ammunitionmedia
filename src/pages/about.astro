---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';

const locations = [
  {
    city: 'Toledo',
    state: 'Ohio',
    description: 'Our Midwest hub, connecting brands across the Great Lakes region and beyond.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
  {
    city: 'Beaufort',
    state: 'South Carolina',
    description: 'Our Southeast presence, serving brands across the Lowcountry and Atlantic coast.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
];

const values = [
  {
    title: 'Data-Driven Decisions',
    description: 'Every recommendation is backed by real-time analytics and audience intelligence. We don\'t guess — we measure.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>`,
  },
  {
    title: 'Channel Agnostic',
    description: 'We go where your audience is — CTV, audio, display, DOOH, or retail media. No channel bias, just results.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>`,
  },
  {
    title: 'Transparent Reporting',
    description: 'Full visibility into campaign performance with real-time dashboards and multi-touch attribution.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    title: 'Privacy-First',
    description: 'Identity resolution and targeting that respects consumer privacy while delivering precision at scale.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
];
---

<BaseLayout
  title="About Us | Ammunition Media"
  description="Learn about Ammunition Media, led by founder John Mark Rankins. Modern AdTech solutions from Toledo, Ohio and Beaufort, South Carolina."
>
  <Header slot="header" currentPath="/about/" />

  <Hero
    title="About"
    titleAccent="Ammunition Media"
    subtitle="The Story Behind the Strategy"
    description="Modern advertising demands modern solutions. We built Ammunition Media to bridge the gap between cutting-edge AdTech and ambitious brands."
    backgroundImage="/images/hero-about.jpg"
  />

  <!-- Founder Section -->
  <section class="founder section">
    <div class="container">
      <div class="founder__grid reveal">
        <div class="founder__image-wrap">
          <div class="founder__coming-soon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>
            <span>Coming Soon</span>
          </div>
          <div class="founder__image-glow" aria-hidden="true"></div>
        </div>
        <div class="founder__content">
          <span class="founder__label">Founder & CEO</span>
          <h2 class="founder__name">John Mark <span class="gradient-text">Rankins</span></h2>
          <p>John Mark Rankins founded Ammunition Media with a clear mission: to make enterprise-grade advertising technology accessible to ambitious brands of every size.</p>
          <p>With deep expertise in programmatic media, identity resolution, and multi-channel campaign strategy, John Mark has spent his career at the intersection of data science and creative storytelling.</p>
          <p>His approach is simple — combine the precision of modern AdTech with the art of compelling creative to deliver measurable business outcomes that scale.</p>
          <div class="founder__connect">
            <a href="https://www.linkedin.com/in/johnmarkrankins/" target="_blank" rel="noopener noreferrer" class="founder__linkedin">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              <span>Connect on LinkedIn</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="mission section">
    <div class="container">
      <div class="mission__grid">
        <div class="mission__card glass-card reveal">
          <h3>Our <span class="gradient-text">Mission</span></h3>
          <p>To empower ambitious brands with the same sophisticated advertising technology and data-driven strategies that were once reserved for Fortune 500 companies.</p>
        </div>
        <div class="mission__card glass-card reveal reveal-delay-1">
          <h3>Our <span class="gradient-text-cyan">Vision</span></h3>
          <p>A world where every brand, regardless of size, can reach the right audience at the right time through intelligent, privacy-compliant advertising.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="values section">
    <div class="container">
      <h2 class="values__title reveal">What Drives <span class="gradient-text">Us</span></h2>
      <div class="values__grid">
        {values.map((val, i) => (
          <div class={`values__card glass-card reveal reveal-delay-${i + 1}`}>
            <div class="values__icon" set:html={val.icon} />
            <h4>{val.title}</h4>
            <p>{val.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Locations Section -->
  <section class="locations section">
    <div class="container">
      <h2 class="locations__title reveal">Our <span class="gradient-text">Markets</span></h2>
      <div class="locations__grid">
        {locations.map((loc, i) => (
          <div class={`locations__card glass-card reveal reveal-delay-${i + 1}`}>
            <div class="locations__icon" set:html={loc.icon} />
            <h3>{loc.city}, <span class="gradient-text">{loc.state}</span></h3>
            <p>{loc.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="final-cta section reveal">
    <div class="final-cta__mesh">
      <div class="mesh-orb mesh-orb--indigo final-cta__orb-1"></div>
      <div class="mesh-orb mesh-orb--pink final-cta__orb-2"></div>
    </div>
    <div class="container final-cta__inner">
      <h2 class="final-cta__title">Let's Work <span class="gradient-text">Together</span></h2>
      <p class="final-cta__body">Ready to turn your advertising into a growth engine? Let's start the conversation.</p>
      <a href="/contact/" class="cta-button final-cta__button">
        <span>Get In Touch</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="position:relative;z-index:1">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Founder */
  .founder__grid {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .founder__image-wrap {
    position: relative;
  }

  .founder__coming-soon {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 20px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    position: relative;
    z-index: 1;
  }

  .founder__coming-soon svg {
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .founder__coming-soon span {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    background: linear-gradient(135deg, var(--color-accent-start), var(--color-accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .founder__image-glow {
    position: absolute;
    inset: -10px;
    border-radius: 24px;
    background: linear-gradient(135deg, var(--color-accent-start), var(--color-accent-end));
    opacity: 0.15;
    filter: blur(30px);
    z-index: 0;
  }

  .founder__label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-solid);
    margin-bottom: var(--space-sm);
  }

  .founder__name {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-md);
  }

  .founder__content p {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .founder__connect {
    margin-top: var(--space-md);
  }

  .founder__linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .founder__linkedin:hover {
    color: var(--color-text);
    border-color: var(--color-border-glow);
    background: rgba(99, 102, 241, 0.08);
  }

  /* Mission */
  .mission__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .mission__card {
    padding: var(--space-xl);
    text-align: center;
  }

  .mission__card h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
  }

  .mission__card p {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  /* Values */
  .values__title {
    text-align: center;
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-xl);
  }

  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .values__card {
    padding: var(--space-lg);
    text-align: center;
  }

  .values__icon {
    color: var(--color-accent-solid);
    margin-bottom: var(--space-sm);
    display: flex;
    justify-content: center;
  }

  .values__card h4 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .values__card p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Locations */
  .locations__title {
    text-align: center;
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-xl);
  }

  .locations__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    max-width: 800px;
    margin: 0 auto;
  }

  .locations__card {
    padding: var(--space-xl);
    text-align: center;
  }

  .locations__icon {
    color: var(--color-accent-solid);
    margin-bottom: var(--space-sm);
    display: flex;
    justify-content: center;
  }

  .locations__card h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  .locations__card p {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  /* Final CTA */
  .final-cta {
    position: relative;
    text-align: center;
    padding: var(--space-3xl) 0;
    overflow: hidden;
  }

  .final-cta__mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .final-cta__orb-1 {
    width: 400px;
    height: 400px;
    top: -20%;
    left: -10%;
    opacity: 0.2;
  }

  .final-cta__orb-2 {
    width: 350px;
    height: 350px;
    bottom: -20%;
    right: -10%;
    opacity: 0.15;
  }

  .final-cta__inner {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }

  .final-cta__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: var(--space-md);
  }

  .final-cta__body {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
    max-width: 550px;
    margin-left: auto;
    margin-right: auto;
  }

  .final-cta__button {
    padding: 1.1rem 3rem;
    font-size: 1rem;
  }

  /* Responsive */
  @media (max-width: 968px) {
    .founder__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .founder__image-wrap {
      max-width: 300px;
      margin: 0 auto;
    }

    .values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .mission__grid,
    .locations__grid,
    .values__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
