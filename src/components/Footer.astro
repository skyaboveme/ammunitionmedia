---

---

<footer class="site-footer">
  <div class="footer__gradient-line"></div>

  <div class="footer__main">
    <div class="footer__inner container">
      <div class="footer__brand">
        <div class="footer__logo">
          <span class="footer-logo-text">AMMUNITI<span class="footer-logo-o">◎</span>N</span>
          <span class="footer-logo-sub">M E D I A</span>
        </div>
        <p class="footer__tagline">Modern AdTech for Ambitious Brands</p>

        <div class="footer__social">
          <a
            href="https://www.linkedin.com/in/johnmarkrankins/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="footer__social-link"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer__nav">
        <div class="footer__nav-group">
          <h4 class="footer__nav-title">Navigate</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/services/">Services</a></li>
            <li><a href="/geo-website/">GEO Website</a></li>
            <li><a href="/case-studies/">Case Studies</a></li>
            <li><a href="/modern-media/">Modern Media</a></li>
            <li><a href="/insights/">Insights</a></li>
          </ul>
        </div>

        <div class="footer__nav-group">
          <h4 class="footer__nav-title">Company</h4>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/industries/">Industries</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>

        <div class="footer__nav-group">
          <h4 class="footer__nav-title">Services</h4>
          <ul>
            <li><a href="/services/">Connected TV</a></li>
            <li><a href="/services/">Digital Audio</a></li>
            <li><a href="/services/">Programmatic</a></li>
            <li><a href="/services/">Identity Resolution</a></li>
          </ul>
        </div>
      </div>

      <div class="footer__cta-area">
        <p class="footer__cta-text">Ready to enhance your reach?</p>
        <a href="/contact/" class="cta-button footer__cta">
          <span>Schedule Consultation</span>
        </a>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Ammunition Media. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    position: relative;
  }

  .footer__gradient-line {
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent-start), var(--color-accent-end), var(--color-cyan), transparent);
  }

  .footer__main {
    background: var(--color-surface);
    padding: var(--space-2xl) 0;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.2fr 1.5fr auto;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* Brand */
  .footer__logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    margin-bottom: var(--space-md);
  }

  .footer-logo-text {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.12em;
  }

  .footer-logo-o {
    background: linear-gradient(135deg, var(--color-accent-start), var(--color-accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-logo-sub {
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-weight: 500;
    background: linear-gradient(135deg, var(--color-accent-start), var(--color-accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.5em;
    text-align: right;
    margin-top: 2px;
  }

  .footer__tagline {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
  }

  .footer__social {
    display: flex;
    gap: 1rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .footer__social-link:hover {
    color: var(--color-text);
    border-color: var(--color-border-glow);
    background: rgba(99, 102, 241, 0.1);
  }

  /* Nav */
  .footer__nav {
    display: flex;
    gap: var(--space-2xl);
  }

  .footer__nav-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .footer__nav-group ul {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__nav-group a {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .footer__nav-group a:hover {
    color: var(--color-text);
  }

  /* CTA */
  .footer__cta-area {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-md);
  }

  .footer__cta-text {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    text-align: right;
  }

  /* Bottom */
  .footer__bottom {
    background: var(--color-bg);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
  }

  .footer__bottom p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
  }

  @media (max-width: 968px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .footer__cta-area {
      align-items: flex-start;
    }

    .footer__cta-text {
      text-align: left;
    }
  }

  @media (max-width: 600px) {
    .footer__nav {
      flex-direction: column;
      gap: var(--space-xl);
    }
  }
</style>
