---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  author?: string;
  datePublished?: string;
}

const {
  title,
  description = 'Ammunition Media offers data-driven digital marketing and targeted advertising solutions. Modern AdTech for ambitious brands - CTV, Digital Audio, Programmatic, Identity Resolution, DOOH, and Retail Media.',
  ogImage = '/images/logo.png',
  canonicalUrl,
  type = 'website',
  author,
  datePublished,
} = Astro.props;

const siteUrl = 'https://www.ammunition.media';
const fullTitle = title.includes('Ammunition Media') ? title : `${title} - Ammunition Media`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();

// Build breadcrumbs from URL path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
  ...pathSegments.map((seg, i) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: seg.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    item: `${siteUrl}/${pathSegments.slice(0, i + 1).join('/')}/`,
  })),
];

// Organization Schema (comprehensive)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Ammunition Media',
  alternateName: 'Ammunition Media LLC',
  url: siteUrl,
  logo: `${siteUrl}/images/logo.png`,
  slogan: 'Modern AdTech for Ambitious Brands',
  description: 'Ammunition Media is a data-driven digital advertising agency specializing in Connected Television (CTV), Digital Audio, Programmatic Display, Identity Resolution, Digital Out of Home (DOOH), and Retail Media Networks. We deliver AI-ready GEO websites and full-funnel media strategies for ambitious brands.',
  founder: {
    '@type': 'Person',
    '@id': `${siteUrl}/#founder`,
    name: 'John Mark Rankins',
    jobTitle: 'Founder & CEO',
    worksFor: { '@id': `${siteUrl}/#organization` },
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'johnmark@ammunition.media',
    contactType: 'sales',
    availableLanguage: 'English',
  },
  areaServed: [
    { '@type': 'City', name: 'Toledo', addressRegion: 'OH', addressCountry: 'US' },
    { '@type': 'City', name: 'Beaufort', addressRegion: 'SC', addressCountry: 'US' },
    { '@type': 'Country', name: 'United States' },
  ],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Toledo', addressRegion: 'OH', addressCountry: 'US' },
    { '@type': 'PostalAddress', addressLocality: 'Beaufort', addressRegion: 'SC', addressCountry: 'US' },
  ],
  knowsAbout: [
    'Connected Television Advertising', 'CTV', 'OTT Advertising',
    'Programmatic Display Advertising', 'Digital Audio Advertising',
    'Identity Resolution', 'Digital Out of Home', 'DOOH',
    'Retail Media Networks', 'Generative Engine Optimization', 'GEO',
    'AI Search Visibility', 'Search Engine Optimization', 'SEO',
    'AdTech', 'Data-Driven Marketing',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Ammunition Media Services',
    itemListElement: [
      { '@type': 'Service', name: 'Connected Television (CTV)', description: 'Streaming TV ads with household-level precision and cross-screen attribution' },
      { '@type': 'Service', name: 'Digital Audio', description: 'Podcast and streaming music advertising with dynamic insertion' },
      { '@type': 'Service', name: 'Programmatic Display, Native & Video', description: 'Real-time bidding, contextual targeting, and cross-device reach' },
      { '@type': 'Service', name: 'Identity Resolution', description: 'Cross-device matching, cookie-free solutions, and unified customer view' },
      { '@type': 'Service', name: 'Digital Out of Home (DOOH)', description: 'Programmatic billboard ads, location-based targeting' },
      { '@type': 'Service', name: 'Retail Media Networks', description: 'Shopper marketing, first-party retail data, and closed-loop attribution' },
      { '@type': 'Service', name: 'GEO Website', description: 'AI-ready website design with Generative Engine Optimization starting at $2,500', offers: { '@type': 'Offer', price: '2500', priceCurrency: 'USD' } },
    ],
  },
  sameAs: [
    'https://www.linkedin.com/in/johnmarkrankins/',
  ],
};

// BreadcrumbList Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

// WebPage Schema
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebPage',
  name: fullTitle,
  description,
  url: canonical,
  inLanguage: 'en-US',
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#organization` },
  ...(author && { author: { '@type': 'Person', name: author } }),
  ...(datePublished && { datePublished }),
  publisher: { '@id': `${siteUrl}/#organization` },
  breadcrumb: { '@id': `${canonical}#breadcrumb` },
};

// WebSite Schema
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'Ammunition Media',
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'en-US',
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Ammunition Media" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {author && <meta name="author" content={author} />}
    {datePublished && <meta itemprop="datePublished" content={datePublished} />}

    <!-- AI Crawler Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Sitemap Discovery -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <!-- JSON-LD: WebPage -->
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <!-- JSON-LD: Breadcrumbs -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- Global Styles -->
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <!-- Scroll Reveal Observer -->
    <script>
      function initReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
        );

        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }

      // Run on initial load and on Astro page transitions
      document.addEventListener('DOMContentLoaded', initReveal);
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
