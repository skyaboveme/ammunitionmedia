---
export interface Props {
  title?: string;
  titleAccent?: string;
  subtitle?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  title = 'Turn Web Traffic',
  titleAccent = 'Into Revenue',
  subtitle = 'Modern AdTech for Ambitious Brands',
  description = 'Strategic advertising solutions that connect your brand with the right audience, at the right time, on the right platform.',
  ctaText = 'Schedule Consultation',
  ctaHref = '/contact/',
} = Astro.props;
---

<section class="hero3d" id="hero3d">
  <canvas id="hero3d-canvas"></canvas>

  <!-- Chromatic aberration overlay -->
  <div class="hero3d__aberration" aria-hidden="true"></div>

  <!-- Gradient overlay for text legibility -->
  <div class="hero3d__overlay" aria-hidden="true"></div>

  <!-- Content -->
  <div class="hero3d__content">
    <p class="hero3d__subtitle">{subtitle}</p>
    <h1 class="hero3d__title">
      {title} <span class="gradient-text">{titleAccent}</span>
    </h1>
    <p class="hero3d__description">{description}</p>
    <a href={ctaHref} class="cta-button hero3d__cta">
      <span>{ctaText}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="position:relative;z-index:1">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>

  <!-- Scroll indicator -->
  <div class="hero3d__scroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="hero3d__scroll-line"></div>
  </div>
</section>

<script>
  import * as THREE from 'three';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- Scene Setup ---
  const canvas = document.getElementById('hero3d-canvas') as HTMLCanvasElement;
  if (!canvas) throw new Error('Canvas not found');

  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: true,
    alpha: true,
  });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.2;

  const scene = new THREE.Scene();

  const camera = new THREE.PerspectiveCamera(
    45,
    window.innerWidth / window.innerHeight,
    0.1,
    100
  );
  camera.position.set(0, 0, 5);

  // --- Glass Sculpture (Icosahedron + inner geometry) ---
  const glassMaterial = new THREE.MeshPhysicalMaterial({
    color: 0x8b5cf6,
    metalness: 0.0,
    roughness: 0.05,
    transmission: 0.95,
    thickness: 1.5,
    ior: 1.5,
    clearcoat: 1.0,
    clearcoatRoughness: 0.1,
    envMapIntensity: 1.5,
    transparent: true,
    opacity: 0.6,
  });

  // Outer shell
  const outerGeo = new THREE.IcosahedronGeometry(1.4, 1);
  const outerMesh = new THREE.Mesh(outerGeo, glassMaterial);

  // Inner structure
  const innerMaterial = new THREE.MeshPhysicalMaterial({
    color: 0xc084fc,
    metalness: 0.3,
    roughness: 0.1,
    transmission: 0.8,
    thickness: 0.5,
    ior: 2.0,
    clearcoat: 1.0,
    transparent: true,
    opacity: 0.5,
  });

  const innerGeo = new THREE.OctahedronGeometry(0.7, 0);
  const innerMesh = new THREE.Mesh(innerGeo, innerMaterial);

  // Core glow
  const coreMaterial = new THREE.MeshBasicMaterial({
    color: 0xc084fc,
    transparent: true,
    opacity: 0.4,
  });
  const coreGeo = new THREE.SphereGeometry(0.25, 16, 16);
  const coreMesh = new THREE.Mesh(coreGeo, coreMaterial);

  // Wireframe overlay
  const wireMaterial = new THREE.MeshBasicMaterial({
    color: 0x6d28d9,
    wireframe: true,
    transparent: true,
    opacity: 0.15,
  });
  const wireGeo = new THREE.IcosahedronGeometry(1.42, 1);
  const wireMesh = new THREE.Mesh(wireGeo, wireMaterial);

  // Group everything
  const sculptureGroup = new THREE.Group();
  sculptureGroup.add(outerMesh, innerMesh, coreMesh, wireMesh);
  scene.add(sculptureGroup);

  // --- Floating particles ---
  const particleCount = 200;
  const particlePositions = new Float32Array(particleCount * 3);
  for (let i = 0; i < particleCount; i++) {
    particlePositions[i * 3] = (Math.random() - 0.5) * 10;
    particlePositions[i * 3 + 1] = (Math.random() - 0.5) * 10;
    particlePositions[i * 3 + 2] = (Math.random() - 0.5) * 10;
  }
  const particleGeo = new THREE.BufferGeometry();
  particleGeo.setAttribute(
    'position',
    new THREE.BufferAttribute(particlePositions, 3)
  );
  const particleMat = new THREE.PointsMaterial({
    color: 0x8b5cf6,
    size: 0.015,
    transparent: true,
    opacity: 0.6,
    sizeAttenuation: true,
  });
  const particles = new THREE.Points(particleGeo, particleMat);
  scene.add(particles);

  // --- Lighting ---
  const ambientLight = new THREE.AmbientLight(0x1a1a2e, 0.5);
  scene.add(ambientLight);

  const mainLight = new THREE.DirectionalLight(0x8b5cf6, 2);
  mainLight.position.set(5, 5, 5);
  scene.add(mainLight);

  const accentLight = new THREE.PointLight(0xec4899, 3, 15);
  accentLight.position.set(-3, 2, 3);
  scene.add(accentLight);

  const fillLight = new THREE.PointLight(0x06b6d4, 2, 12);
  fillLight.position.set(3, -2, 2);
  scene.add(fillLight);

  const backLight = new THREE.PointLight(0x6d28d9, 2, 10);
  backLight.position.set(0, 0, -5);
  scene.add(backLight);

  // --- Environment map (simple gradient) ---
  const pmremGenerator = new THREE.PMREMGenerator(renderer);
  const envScene = new THREE.Scene();
  const envGeo = new THREE.SphereGeometry(10, 32, 32);
  const envMat = new THREE.MeshBasicMaterial({
    color: 0x0a0a1a,
    side: THREE.BackSide,
  });
  envScene.add(new THREE.Mesh(envGeo, envMat));
  const envMap = pmremGenerator.fromScene(envScene).texture;
  scene.environment = envMap;
  pmremGenerator.dispose();

  // --- Mouse tracking ---
  const mouse = { x: 0, y: 0 };
  const targetRotation = { x: 0, y: 0 };

  window.addEventListener('mousemove', (e) => {
    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  // --- Scroll-triggered camera fly-through ---
  const scrollState = { progress: 0 };

  ScrollTrigger.create({
    trigger: '#hero3d',
    start: 'top top',
    end: 'bottom top',
    scrub: 1,
    onUpdate: (self) => {
      scrollState.progress = self.progress;
    },
  });

  // --- Entrance animation ---
  gsap.from(sculptureGroup.scale, {
    x: 0,
    y: 0,
    z: 0,
    duration: 1.5,
    ease: 'elastic.out(1, 0.5)',
    delay: 0.3,
  });

  gsap.from(sculptureGroup.rotation, {
    y: Math.PI * 2,
    duration: 2,
    ease: 'power3.out',
    delay: 0.3,
  });

  // Content entrance
  gsap.from('.hero3d__subtitle', {
    y: 30,
    opacity: 0,
    duration: 0.8,
    delay: 0.5,
  });
  gsap.from('.hero3d__title', {
    y: 40,
    opacity: 0,
    duration: 0.8,
    delay: 0.7,
  });
  gsap.from('.hero3d__description', {
    y: 30,
    opacity: 0,
    duration: 0.8,
    delay: 0.9,
  });
  gsap.from('.hero3d__cta', {
    y: 20,
    opacity: 0,
    duration: 0.8,
    delay: 1.1,
  });
  gsap.from('.hero3d__scroll', {
    opacity: 0,
    duration: 1,
    delay: 1.5,
  });

  // --- Animation Loop ---
  const clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);
    const elapsed = clock.getElapsedTime();

    // Mouse-tracked rotation (smooth lerp)
    targetRotation.x = mouse.y * 0.3;
    targetRotation.y = mouse.x * 0.4;

    sculptureGroup.rotation.x +=
      (targetRotation.x - sculptureGroup.rotation.x) * 0.05;
    sculptureGroup.rotation.y +=
      (targetRotation.y - sculptureGroup.rotation.y) * 0.05;

    // Idle rotation
    sculptureGroup.rotation.y += 0.002;
    sculptureGroup.rotation.z = Math.sin(elapsed * 0.3) * 0.05;

    // Inner geometry counter-rotation
    innerMesh.rotation.x = elapsed * 0.5;
    innerMesh.rotation.y = elapsed * 0.3;

    // Core pulse
    const pulse = 1 + Math.sin(elapsed * 2) * 0.1;
    coreMesh.scale.set(pulse, pulse, pulse);
    (coreMesh.material as THREE.MeshBasicMaterial).opacity =
      0.3 + Math.sin(elapsed * 3) * 0.15;

    // Particles drift
    particles.rotation.y = elapsed * 0.03;
    particles.rotation.x = elapsed * 0.01;

    // Accent light orbit
    accentLight.position.x = Math.sin(elapsed * 0.7) * 4;
    accentLight.position.z = Math.cos(elapsed * 0.7) * 4;
    fillLight.position.x = Math.cos(elapsed * 0.5) * 3;
    fillLight.position.y = Math.sin(elapsed * 0.5) * 2;

    // Scroll-driven camera fly-through
    const p = scrollState.progress;
    camera.position.z = 5 - p * 3;
    camera.position.y = p * 1.5;
    camera.position.x = Math.sin(p * Math.PI) * 1;
    camera.lookAt(sculptureGroup.position);

    // Scroll fade-out for sculpture
    sculptureGroup.scale.setScalar(1 - p * 0.3);

    renderer.render(scene, camera);
  }

  animate();

  // --- Resize handler ---
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

<style>
  .hero3d {
    position: relative;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0a0a0f;
  }

  #hero3d-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* Chromatic aberration effect */
  .hero3d__aberration {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(139, 92, 246, 0.06) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 80%, rgba(236, 72, 153, 0.04) 0%, transparent 60%),
      radial-gradient(ellipse at 50% 50%, rgba(6, 182, 212, 0.03) 0%, transparent 50%);
    mix-blend-mode: screen;
  }

  .hero3d__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      transparent 30%,
      rgba(10, 10, 15, 0.4) 70%,
      rgba(10, 10, 15, 0.8) 100%
    );
  }

  .hero3d__content {
    position: relative;
    z-index: 4;
    text-align: center;
    max-width: 800px;
    padding: 0 var(--space-md);
  }

  .hero3d__subtitle {
    font-size: clamp(0.75rem, 1.5vw, 0.85rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent-solid);
    margin-bottom: var(--space-sm);
  }

  .hero3d__title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    margin-bottom: var(--space-md);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .hero3d__description {
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }

  .hero3d__cta {
    padding: 1.1rem 3rem;
    font-size: 1rem;
  }

  /* Scroll indicator */
  .hero3d__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hero3d__scroll span {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
  }

  .hero3d__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(
      to bottom,
      var(--color-accent-solid),
      transparent
    );
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .hero3d__title {
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .hero3d__scroll {
      display: none;
    }
  }
</style>
