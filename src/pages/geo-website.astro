<script>
  // ROI Calculator
  const slider = document.getElementById('traffic-slider') as HTMLInputElement;
  const trafficValue = document.getElementById('traffic-value');
  const citationsResult = document.getElementById('citations-result');
  const visitorsResult = document.getElementById('visitors-result');
  const revenueResult = document.getElementById('revenue-result');

  function formatNumber(n: number): string {
    return n.toLocaleString('en-US');
  }

  function updateROI() {
    if (!slider || !trafficValue || !citationsResult || !visitorsResult || !revenueResult) return;

    const traffic = parseInt(slider.value);
    const citationRate = 0.068;
    const clickMultiplier = 3.5;
    const revenuePerVisitor = 5;

    const citations = Math.round(traffic * citationRate);
    const additionalVisitors = Math.round(citations * clickMultiplier);
    const revenue = additionalVisitors * revenuePerVisitor;

    trafficValue.textContent = formatNumber(traffic);
    citationsResult.textContent = formatNumber(citations);
    visitorsResult.textContent = formatNumber(additionalVisitors);
    revenueResult.textContent = `$${formatNumber(revenue)}`;
  }

  slider?.addEventListener('input', updateROI);
  updateROI();

  // Floating Pill Nav
  const pillNav = document.getElementById('pill-nav');
  const sections = document.querySelectorAll('[id]');
  const pillItems = document.querySelectorAll('.pill-nav__item');

  // Show/hide pill nav based on scroll
  function updatePillNav() {
    if (!pillNav) return;
    const scrollY = window.scrollY;
    const hero = document.querySelector('.hero');
    const heroBottom = hero ? (hero as HTMLElement).offsetTop + (hero as HTMLElement).offsetHeight : 600;
    const footer = document.querySelector('footer');
    const footerTop = footer ? (footer as HTMLElement).offsetTop - window.innerHeight : Infinity;

    if (scrollY > heroBottom && scrollY < footerTop) {
      pillNav.classList.add('is-visible');
    } else {
      pillNav.classList.remove('is-visible');
    }

    // Update active state
    let current = '';
    sections.forEach((section) => {
      const el = section as HTMLElement;
      const sectionTop = el.offsetTop - 200;
      if (scrollY >= sectionTop) {
        current = el.id;
      }
    });

    pillItems.forEach((item) => {
      item.classList.remove('is-active');
      if (item.getAttribute('data-section') === current) {
        item.classList.add('is-active');
      }
    });
  }

  window.addEventListener('scroll', updatePillNav, { passive: true });
  updatePillNav();

  // Smooth scroll for pill nav
  pillItems.forEach((item) => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = item.getAttribute('href')?.slice(1);
      if (targetId) {
        document.getElementById(targetId)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
